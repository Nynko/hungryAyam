  "query": "\n            SELECT it.item_id, t.id as tag_id, t.name as \"tag_name: Name\"\n            FROM item_tags it\n            INNER JOIN tags t ON t.id = it.tag_id\n            WHERE it.item_id = ANY($1)\n            ORDER BY t.name ASC\n            ",
