# ═══════════════════════════════════════════════════════════════════
# HungryAyam — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to `.env` and adjust values for your deployment.
# All variables have sensible defaults in docker-compose.yml.
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=hungryayam
POSTGRES_PASSWORD=hungryayam
POSTGRES_DB=hungryayam

# ── Backend ────────────────────────────────────────────────────────
# Address the backend binds to (inside the container)
BIND_ADDR=0.0.0.0:3000

# DATABASE_URL is constructed automatically in docker-compose.yml
# Override only if running the backend outside Docker:
# DATABASE_URL=postgres://hungryayam:hungryayam@localhost:5432/hungryayam

# Set to "false" to disable the Secure flag on cookies (for local
# HTTP development without TLS). In production, leave unset or set
# to "true" so cookies are only sent over HTTPS.
# SECURE_COOKIES=false

# Optional: set an explicit allowed CORS origin for development.
# In production, nginx proxies everything (same-origin), so this
# is not needed. Example for local Vite dev server:
# CORS_ORIGIN=http://localhost:5173

# ── Frontend ───────────────────────────────────────────────────────
# Port exposed on the host for the frontend (nginx)
APP_PORT=8080

# App title shown in the browser tab and UI
VITE_APP_TITLE=HungryAyam

# Optional: default image URL used in the app
# VITE_APP_IMAGE_URL=
#


ANTHROPIC_API_KEY=
# Optional: override the Claude model used for menu scanning. Defaults to
# claude-sonnet-5 if unset. Anthropic periodically retires old model
# snapshots (404 Not Found) — set this to bump the model without a rebuild.
# ANTHROPIC_MODEL=claude-sonnet-5

# ── OVH SMS fallback (optional) ────────────────────────────────────
# If the iPhone Shortcut hasn't confirmed the SMS 5 min after receiving the
# notification email (or 6 min after sending, if it never arrived), the
# server sends the SMS itself through OVH. Requires NOTIFICATION_SECRET.
# Create credentials at https://eu.api.ovh.com/createToken/ with rights:
#   GET /sms/*   and   POST /sms/*/jobs
# OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# SMS account name, e.g. sms-ab12345-1 (OVH console → Telecom → SMS)
OVH_SMS_SERVICE_NAME=
# Optional validated sender name. Leave empty to send from an OVH short number.
OVH_SMS_SENDER=
