# Database configuration
DATABASE_URL=

# Server configuration
BIND_ADDR=

# Rust log level
RUST_LOG=info

ANTHROPIC_API_KEY=

# Upload directory (local dev: any writable path, e.g. ./uploads)
UPLOAD_DIR=./uploads

# Email / SMTP configuration (optional — verification emails disabled if not set)
SMTP_HOST=
# iCloud: use port 465 (implicit SSL). Port 587 (STARTTLS) does not work with iCloud.
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public base URL used in email links (e.g. https://yourdomain.com)
APP_BASE_URL=http://localhost:5173

# HMAC secret for signing/verifying order notification emails (optional).
# If set, each notification email includes TS: and SIG: lines that the
# iPhone Shortcut verifies via /api/verify-notification before sending the SMS.
# Generate with: openssl rand -hex 32
NOTIFICATION_SECRET=

# ── OVH SMS fallback (optional) ────────────────────────────────────
# If the iPhone Shortcut hasn't confirmed the SMS 5 min after receiving the
# notification email (or 6 min after sending, if it never arrived), the
# server sends the SMS itself through OVH. Requires NOTIFICATION_SECRET.
# Create credentials at https://eu.api.ovh.com/createToken/ with rights:
#   GET /sms/*   and   POST /sms/*/jobs
# OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# SMS account name, e.g. sms-ab12345-1 (OVH console → Telecom → SMS)
OVH_SMS_SERVICE_NAME=
# Optional validated sender name. Leave empty to send from an OVH short number.
OVH_SMS_SENDER=
