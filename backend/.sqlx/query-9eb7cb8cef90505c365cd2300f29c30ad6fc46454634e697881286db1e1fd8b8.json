{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT DISTINCT\n                r.id,\n                r.name as \"name: Name\",\n                r.image_url as \"image_url?: UrlString\",\n                r.created_at,\n                r.created_by,\n                r.updated_at,\n                r.updated_by\n            FROM restaurants r\n            INNER JOIN order_sessions os ON os.restaurant_id = r.id\n            WHERE os.end_date > NOW()\n            ORDER BY r.created_at DESC\n            ",
