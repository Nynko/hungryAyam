{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                o.id,\n                o.user_id,\n                o.session_id,\n                o.total_price_cents,\n                COUNT(oi.id) as \"item_count!\",\n                o.created_at\n            FROM orders o\n            LEFT JOIN order_items oi ON oi.order_id = o.id\n            WHERE o.session_id = $1\n            GROUP BY o.id\n            ORDER BY o.created_at ASC\n            ",
