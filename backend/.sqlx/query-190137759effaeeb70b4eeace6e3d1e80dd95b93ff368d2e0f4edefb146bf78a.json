{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                restaurant_id,\n                start_date,\n                end_date,\n                allow_late,\n                status as \"status: OrderSessionStatus\",\n                created_at,\n                created_by,\n                updated_at,\n                updated_by\n            FROM order_sessions\n            WHERE restaurant_id = $1\n              AND status = $2\n              AND end_date > NOW()\n            ORDER BY created_at DESC\n            LIMIT 1\n            ",
