  "query": "\n            UPDATE order_sessions\n            SET start_date  = COALESCE($1, start_date),\n                end_date    = COALESCE($2, end_date),\n                allow_late  = COALESCE($3, allow_late),\n                updated_at  = NOW(),\n                updated_by  = $5\n            WHERE id = $4\n            RETURNING\n                id,\n                restaurant_id,\n                start_date,\n                end_date,\n                allow_late,\n                status as \"status: OrderSessionStatus\",\n                created_at,\n                created_by,\n                updated_at,\n                updated_by\n            ",
