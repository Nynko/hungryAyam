  "query": "\n            UPDATE restaurants\n            SET name = COALESCE($1, name),\n                image_url = COALESCE($2, image_url),\n                updated_at = NOW(),\n                updated_by = $4\n            WHERE id = $3\n            RETURNING\n                id,\n                name as \"name: Name\",\n                image_url as \"image_url?: UrlString\",\n                created_at,\n                created_by,\n                updated_at,\n                updated_by,\n                availability_rule_id\n            ",
