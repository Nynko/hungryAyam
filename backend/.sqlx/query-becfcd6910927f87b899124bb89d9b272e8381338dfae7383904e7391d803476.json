  "query": "\n            INSERT INTO restaurant_order_settings (restaurant_id)\n            VALUES ($1)\n            ON CONFLICT (restaurant_id) DO UPDATE SET restaurant_id = EXCLUDED.restaurant_id\n            RETURNING\n                id,\n                restaurant_id,\n                default_start_time,\n                default_end_time,\n                sending_method as \"sending_method: SendingMethod\",\n                timezone,\n                auto_create_session,\n                menu_reset_time,\n                auto_close_session,\n                notify_on_session_close,\n                default_pickup_time,\n                created_at,\n                updated_at\n            ",
