{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                oi.id,\n                oi.order_id,\n                oi.item_id,\n                it.name as item_name,\n                it.base_price_cents as \"item_price_cents: PriceCents\",\n                oi.slot_id,\n                oi.notes\n            FROM order_items oi\n            JOIN items it ON it.id = oi.item_id\n            WHERE oi.order_id = $1\n            ",
