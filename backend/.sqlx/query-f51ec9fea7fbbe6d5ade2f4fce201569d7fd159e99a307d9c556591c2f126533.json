  "query": "\n            SELECT\n                id,\n                restaurant_id,\n                menu_id,\n                title as \"title: Name\",\n                description,\n                base_price_cents as \"base_price_cents: PriceCents\",\n                is_active,\n                created_at,\n                created_by,\n                availability_rule_id\n            FROM offers\n            WHERE restaurant_id = $1 AND is_active = true\n            ORDER BY created_at DESC\n            ",
